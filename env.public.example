# Video Generation Configuration - Public Settings
# Copy this file to .env.public for non-secret configuration
# This file CAN be committed to git

# LLM Configuration
VG_LLM__PROVIDER=anthropic
VG_LLM__MODEL=claude-sonnet-4-5-20250929
VG_LLM__TEMPERATURE=0.7
VG_LLM__MAX_TOKENS=4096
VG_LLM__VISION_MODEL=claude-haiku-4-5-20251001

# TTS Configuration
VG_TTS__PROVIDER=fish
VG_TTS__HOST=127.0.0.1
VG_TTS__PORT=8003
# VG_TTS__REFERENCE_AUDIO=/path/to/reference.mp4
# VG_TTS__REFERENCE_TEXT=Reference text for voice cloning

# Fish-Speech TTS Parameters
VG_TTS__MAX_NEW_TOKENS=1024
VG_TTS__CHUNK_LENGTH=300
VG_TTS__TOP_P=0.8
VG_TTS__REPETITION_PENALTY=1.1
VG_TTS__TEMPERATURE=0.8

# STT Configuration
VG_STT__PROVIDER=whisper
VG_STT__MODEL=base

# Video Retrieval Configuration
VG_VIDEO_RETRIEVAL__METHOD=bm25
VG_VIDEO_RETRIEVAL__INDEX_PATH=/media/amor/data1/Downloads/CPS/clip_infos
# VG_VIDEO_RETRIEVAL__VECTOR_STORE_PATH=/path/to/vector/store
VG_VIDEO_RETRIEVAL__EMBEDDING_MODEL=lightonai/modernbert-embed-large
VG_VIDEO_RETRIEVAL__TOP_K=10
VG_VIDEO_RETRIEVAL__CHARACTER_FILTER=fred

# Prompt Configuration
VG_PROMPT__PROVIDER=local
VG_PROMPT__LOCAL_FILE=prompts/story_generation.txt

# Video Processing
VG_VIDEO_PROCESSING__RESOLUTION=720x480
VG_VIDEO_PROCESSING__CODEC=h264_nvenc
VG_VIDEO_PROCESSING__BITRATE=3000k
VG_VIDEO_PROCESSING__FONTSIZE=14

# Search and Matching
VG_MAX_SEARCH_ATTEMPTS=3
VG_MAX_VIDEO_JUDGEMENT_ATTEMPTS=5

# Text Processing
VG_MAX_SENTENCE_LENGTH=35

# Output Paths
VG_OUTPUT_DIR=./output
VG_TEMP_DIR=./temp

# Parallelization
VG_MAX_PARALLEL_LLM_CALLS=5

# Config Dump
VG_ENABLE_CONFIG_DUMP=true
VG_CONFIG_DUMP_FILENAME=generation_config.json

