# Video Generation Configuration - Secrets
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to git!

# LLM API Keys (choose one or more)
VG_LLM__API_KEY=your-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key

# MinIO Storage Configuration
# MinIO stores binary files (audio, video)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=virtual-streamer
# Set to "true" for HTTPS connections
MINIO_SECURE=false

# MySQL Configuration
# MySQL stores entity metadata (characters, clips, etc.)
# For Docker Compose, these are set automatically. For local dev:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=virtual_streamer
MYSQL_PASSWORD=streamerpass
MYSQL_DATABASE=virtual_streamer

# Optional: Fish TTS API key (if required)
# FISH_TTS_API_KEY=YOUR_API_KEY

# Job Storage Backend Configuration (for async job tracking)
# Options: memory (default - lost on restart), mysql (persistent)
JOB_STORAGE_BACKEND=memory
