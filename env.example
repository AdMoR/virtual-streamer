# Video Generation Configuration - Secrets
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to git!

# LLM API Keys (choose one or more)
VG_LLM__API_KEY=your-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key

# Optional: AWS credentials for S3 (if using)
# AWS_ACCESS_KEY=your-access-key
# AWS_SECRET_KEY=your-secret-key

# Optional: Fish TTS API key (if required)
# FISH_TTS_API_KEY=YOUR_API_KEY

# Entity Storage Backend Configuration
# Options: local (default), s3, mysql
ENTITY_STORAGE_BACKEND=local

# MySQL Configuration (required if ENTITY_STORAGE_BACKEND=mysql)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=virtual_streamer
# MYSQL_PASSWORD=your-password
# MYSQL_DATABASE=virtual_streamer

